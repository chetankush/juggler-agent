# ----- Database -----
# DEV (default): local Docker Postgres with pgvector, on port 5435 (`docker compose up -d`).
DATABASE_URL=postgresql://aicrm:aicrm@localhost:5435/aicrm
# PROD: Supabase Postgres — replace with your project's connection string.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ----- Supabase -----
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Redis -----
# DEV (default): local Docker Redis on port 6382 (`docker compose up -d`).
REDIS_URL=redis://localhost:6382
# PROD: Upstash — replace with your `rediss://` connection string.
# REDIS_URL=rediss://default:[PASSWORD]@[HOST]:6379

# ----- OpenRouter (chat + embeddings) -----
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ----- Discord -----
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# ----- Service URLs -----
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
PORT=3001
